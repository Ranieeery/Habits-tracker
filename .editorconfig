root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2

# YAML does not allow tabs for indentation.
[*.{yml,yaml}]
indent_style = space

# Tabs in Markdown can turn into code blocks.
[*.md]
indent_style = space
trim_trailing_whitespace = false