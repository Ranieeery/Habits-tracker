# Local configuration for `wrangler dev`. Copy to `.dev.vars` (gitignored) and
# fill in the secrets. In production, set secrets with `wrangler secret put`.

ENVIRONMENT=development

# Secret used to sign sessions and cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Public URL of the API (Better Auth builds callback URLs from it).
BETTER_AUTH_URL=http://localhost:8787

# Browser origins allowed by CORS and Better Auth (comma-separated). Keep the
# Vite dev (5173) and preview (4173) servers here even though they proxy /api:
# Better Auth still checks the Origin header of sign-in and sign-out.
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173

# Signup is open only while no user exists. "true" reopens it (dev only).
ALLOW_SIGNUP=false

# Optional: only this email may create the first (owner) account.
OWNER_EMAIL=

# Web Push (VAPID). Generate a pair with `pnpm --filter api vapid:generate`
# and put the same public key in apps/web/.env (VITE_VAPID_PUBLIC_KEY).
# Without them, web devices are skipped (Expo still works).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services about this sender (required by VAPID): the app's
# https URL, or a mailto: address. Nothing is ever emailed.
VAPID_SUBJECT=https://habits.rxniery.workers.dev

# Optional: only if "enhanced security" (push access token) is enabled in the
# Expo project settings.
EXPO_ACCESS_TOKEN=
