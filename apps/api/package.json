{
	"name": "api",
	"version": "2.7.0",
	"private": true,
	"type": "module",
	"exports": {
		"./app": {
			"types": "./dist/types/src/app-type.d.ts"
		}
	},
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"cf-typegen": "wrangler types --strict-vars=false src/worker-configuration.d.ts",
		"auth:generate": "pnpm dlx auth@1.7.7 generate --config scripts/auth-cli.ts --output src/db/auth-schema.ts --adapter drizzle --dialect sqlite --yes && prettier --write src/db/auth-schema.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:backup:remote": "node scripts/backup.ts --remote",
		"db:backup:local": "node scripts/backup.ts --local",
		"db:restore:prepare": "node scripts/restore-prepare.ts",
		"migrations:check": "node scripts/check-migrations.ts",
		"db:seed:local": "node scripts/seed-local.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p tsconfig.node.json",
		"build:types": "tsc -p tsconfig.types.json",
		"lint": "eslint .",
		"test": "vitest run",
		"vapid:generate": "node scripts/generate-vapid-keys.ts",
		"cpu-report": "node scripts/cpu-report.ts"
	},
	"dependencies": {
		"@better-auth/expo": "1.7.7",
		"@habits/contracts": "workspace:*",
		"@habits/core": "workspace:*",
		"@hono/swagger-ui": "0.6.1",
		"@hono/zod-openapi": "1.6.3",
		"better-auth": "1.7.7",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.13",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.0",
		"@types/node": "^24.19.2",
		"drizzle-kit": "^0.31.11",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "^4.149.0"
	}
}
