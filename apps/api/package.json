{
	"name": "api",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"cf-typegen": "wrangler types src/worker-configuration.d.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:seed:local": "node scripts/seed-local.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p tsconfig.node.json",
		"lint": "eslint .",
		"test": "vitest run"
	},
	"dependencies": {
		"@habits/contracts": "workspace:*",
		"@habits/core": "workspace:*",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.13"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.0",
		"@types/node": "^24.19.2",
		"drizzle-kit": "^0.31.11",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "^4.149.0"
	}
}
