{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "habits-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "habits",
			// Placeholder: replace with the id printed by `wrangler d1 create habits`
			// before the first remote migration (Phase 8). Local D1 ignores it.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations",
		},
	],
}
