# Copy to .env (gitignored). Read by Metro at bundle time (`expo start`), so
# changing it needs a Metro restart, not a new development build.
# API base URL, without `/v1` and without a trailing slash.

# Local API, phone on USB with `adb reverse tcp:8787 tcp:8787`:
EXPO_PUBLIC_API_URL=http://localhost:8787

# Local API over Wi-Fi (`pnpm --filter api dev -- --ip 0.0.0.0`):
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8787

# Production (public gateway Worker; the API Worker has no public URL):
# EXPO_PUBLIC_API_URL=https://habits.rxniery.workers.dev/api
