{
	"cli": {
		"version": ">= 24.0.0",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"pnpm": "12.10.1",
			"environment": "development",
			"android": {
				"buildType": "apk"
			}
		},
		"preview": {
			"distribution": "internal",
			"pnpm": "12.10.1",
			"channel": "preview",
			"environment": "preview",
			"android": {
				"buildType": "apk"
			}
		},
		"production": {
			"distribution": "internal",
			"pnpm": "12.10.1",
			"channel": "production",
			"environment": "production",
			"autoIncrement": true,
			"android": {
				"buildType": "apk"
			}
		}
	}
}
