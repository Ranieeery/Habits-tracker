# Copy to .env (gitignored). Vite reads it in dev, preview and build.

# Where the browser calls the API. Same origin in every environment: the Vite
# dev/preview server proxies it, and production routes /api/* to the Worker.
VITE_API_URL=/api

# Dev/preview only: where the proxy forwards /api/* (the `/api` prefix is
# stripped, so /api/v1/habits reaches <target>/v1/habits). Not exposed to the
# browser (no VITE_ prefix).
API_PROXY_TARGET=http://localhost:8787

# Web Push public key (base64url): the same value as the API's
# VAPID_PUBLIC_KEY (`pnpm --filter api vapid:generate`). Public, not a secret.
# Empty: the app shows notifications as unavailable.
VITE_VAPID_PUBLIC_KEY=
