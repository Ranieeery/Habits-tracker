{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Public Worker: serves the built PWA and forwards /api/* to the private API
	// Worker (apps/api, "habits-api"). Deploy the API first: the binding target
	// must exist. `pnpm --filter web run deploy` builds dist/ and deploys.
	"name": "habits",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Client-side routes (/habits, /day/...) get index.html.
		"not_found_handling": "single-page-application",
		// Only API calls invoke the Worker; assets are served directly.
		"run_worker_first": ["/api", "/api/*"],
	},
	"services": [{ "binding": "API", "service": "habits-api" }],
	// Workers Logs: only /api/* invokes this Worker (assets are served
	// without it), so these are gateway invocations.
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
	},
}
