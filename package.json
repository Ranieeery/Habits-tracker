{
	"name": "habits-tracker",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"dev": "turbo run dev --filter=api --filter=web",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"lint": "turbo run lint",
		"test": "turbo run test",
