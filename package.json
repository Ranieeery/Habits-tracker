		"lockfile:check": "node scripts/check-lockfile.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"turbo": "^2.11.11",
		"typescript": "catalog:",
		"typescript-eslint": "^8.72.2"
	}
}
