{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"build:types": {
			"dependsOn": ["^build:types"],
			"outputs": ["dist/types/**"]
		},
		"typecheck": {
			"dependsOn": ["^build:types"]
		},
		"lint": {},
		"test": {},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
